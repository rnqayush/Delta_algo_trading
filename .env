# Local development configuration.
# This file is git-ignored. Never put real secrets in source control.

NODE_ENV=development
PORT=5001

MONGODB_URI=mongodb://127.0.0.1:27017/delta_trading_bot

JWT_SECRET=dev_only_secret_please_change_me_1234567890
JWT_EXPIRES_IN=7d

# Add your own Delta Exchange API keys here (they stay on your machine).
DELTA_API_KEY=6mHRbMWUVAhZ2tne8jN6LMp7wixxfV
DELTA_API_SECRET=aZjVzXAmzfmfoCNbXxLR2NuTLYHTmRzYIGXUIbGzpGdrAcHY6exMw25xfN7x
DELTA_BASE_URL=https://api.india.delta.exchange
DELTA_WS_URL=wss://socket.india.delta.exchange
DELTA_TIMEOUT_MS=10000
DELTA_MAX_RETRIES=2

ENABLE_WEBSOCKET=true

# Safety: keep paper mode until you fully trust your strategy.
TRADING_MODE=live
ENABLE_LIVE_TRADING=true

# The instrument(s) the bot trades and streams live data for. TRADING_SYMBOLS
# (comma-separated) tracks several instruments together with ONE shared
# position slot — whichever gets a cross first takes it. Leave it empty to run
# TRADING_SYMBOL alone, and keep TRADING_SYMBOL as the primary fallback.
TRADING_SYMBOL=EVAAUSD
# SuperTrendStrategy tracks the whole list with ONE shared position slot: whichever
# instrument gets a trend flip first takes the trade (see
# orderManager.concurrencyGate). Contract sizes differ per instrument, so
# STRATEGY_FIXED_CONTRACTS=1 buys 1 EVAA / 1 SOL / 1 XRP / 100 DOGE per trade.
TRADING_SYMBOLS=EVAAUSD

# Caps are in CONTRACTS (order/position size) and quote-currency PnL (daily
# loss). VHR-15 sizes from the stop distance. These are tuned for a small
# leveraged live-test account (see the strategy block below).
RISK_TRADING_ENABLED=true
RISK_MAX_ORDER_QUANTITY=2000
RISK_MAX_POSITION_SIZE=3000
RISK_MAX_DAILY_LOSS=3
RISK_MAX_OPEN_TRADES=2
RISK_MAX_PRICE_DEVIATION_PERCENT=5
RISK_DUPLICATE_WINDOW_SECONDS=5

# Super Trend 2 MACD on 1m (SuperTrend2Macd1m) — active strategy is set in
# src/strategies/strategyManager.js (ACTIVE_STRATEGY = "SuperTrend2Macd1m").
# A local SuperTrend (2/21) flip, confirmed by the last COMPLETED 2h SuperTrend
# (2/7) and an SMA MACD (12/26/9), enters with a resting MAKER limit and sends a
# 500/400-point reduce-only bracket to Delta. An opposite signal reverses the
# position. One entry per 1m bar.
# Live-test account: ~1000 INR (~11.4 USD-equivalent). With ~20x margin on
# Delta (~4 USD locked per BTCUSD contract) the account can carry 1 contract,
# so orders are fixed at 1 lot below.
STRATEGY_EQUITY=11.4
STRATEGY_RISK_PERCENT=0.05
STRATEGY_REWARD_PERCENT=0.01
STRATEGY_MAX_RISK_PERCENT=0.05
# Exposure ceiling in multiples of equity. 20 lets each of the 2 slots afford
# 1 contract (20 x 11.4 / 2 = 114 USD >= 81.6 USD notional per contract).
STRATEGY_MAX_NOTIONAL_EQUITY=20
# Floor so a tiny account still trades the exchange minimum (1 contract).
STRATEGY_MIN_CONTRACTS=1
# Position size in contracts. Set > 0 to always trade this many lots and bypass
# the risk-based sizing (necessary on a tiny account, where the risk-based size
# rounds to zero). 0 falls back to risk-based sizing / STRATEGY_MIN_CONTRACTS.
STRATEGY_FIXED_CONTRACTS=1
# A resting entry limit is cancelled after this many minutes. SuperTrend2Macd1m
# arms the maker limit at the signal bar's close and waits for a pullback to it.
STRATEGY_ENTRY_VALIDITY_MINUTES=15
STRATEGY_EVALUATE_INTERVAL_MS=3000
STRATEGY_CANDLES_15M=2000
STRATEGY_CANDLES_1H=100
# 5m feed: the base timeframe of TRSRating5m. It needs >= 260 closed 5m bars to
# warm up, so 1000 keeps ~3.5 days of history. 0 disables the request.
STRATEGY_CANDLES_5M=1000
# 3m feed: the base timeframe of MacdCci3m. It needs >= 30 closed 3m bars to warm
# up (CCI14 + EMA26), so 1000 keeps ~2 days of history. 0 disables the request.
STRATEGY_CANDLES_3M=1000
# 1m feed: used by the 1m strategies (SuperTrend2Macd1m, OpenCloseCross1m, ...).
# The 2h SuperTrend warm-up needs ~1000 closed 1m bars (Delta caps a request at
# ~2000), so keep this >= 1000. 0 disables the feed.
STRATEGY_CANDLES_1M=2000
# One bracket at a time; keep at 1 so live matches the strategy.
STRATEGY_MAX_CONCURRENT_POSITIONS=1

# Leverage management. In live mode the engine re-checks each tracked product
# (about once a minute, and only while flat) and raises its leverage so the
# strategy's pinned lots fit inside STRATEGY_EQUITY with headroom. It NEVER
# lowers an already-sufficient leverage and never exceeds the product maximum.
LEVERAGE_AUTO_SET=false
LEVERAGE_BUFFER=1.25

LOG_LEVEL=info
