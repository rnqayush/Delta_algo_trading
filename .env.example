# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# ---------------------------------------------------------------------------
# Database (MongoDB)
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/delta_trading_bot

# ---------------------------------------------------------------------------
# Authentication (JWT)
# Use a long random string here. Never commit the real value.
# ---------------------------------------------------------------------------
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Delta Exchange API
# Create API keys in your Delta Exchange account. NEVER hardcode them.
# India endpoint : https://api.india.delta.exchange  / wss://socket.india.delta.exchange
# Global endpoint: https://api.delta.exchange        / wss://socket.delta.exchange
# ---------------------------------------------------------------------------
DELTA_API_KEY=
DELTA_API_SECRET=
DELTA_BASE_URL=https://api.india.delta.exchange
DELTA_WS_URL=wss://socket.india.delta.exchange
DELTA_TIMEOUT_MS=10000
DELTA_MAX_RETRIES=2

# Set to false to disable the real-time WebSocket connection entirely
ENABLE_WEBSOCKET=true

# ---------------------------------------------------------------------------
# Trading mode safety
# TRADING_MODE=paper  -> orders are simulated and stored locally (default)
# TRADING_MODE=live   -> orders are sent to Delta Exchange
# ENABLE_LIVE_TRADING MUST be true as well, otherwise live orders are blocked.
# ---------------------------------------------------------------------------
TRADING_MODE=paper
ENABLE_LIVE_TRADING=false

# ---------------------------------------------------------------------------
# Instrument
# The single symbol the bot streams live data for and trades.
# ---------------------------------------------------------------------------
TRADING_SYMBOL=BTCUSD

# ---------------------------------------------------------------------------
# Risk management
# These caps are enforced by riskManager.js BEFORE anything is sent to Delta.
# They are in CONTRACTS (order/position size) and in quote-currency PnL
# (daily loss). The VHR-15 strategy sizes from the stop distance, which on
# BTCUSD can mean several contracts per slot — set these caps to match your
# account, otherwise every order will be rejected as "above the maximum".
# ---------------------------------------------------------------------------
RISK_TRADING_ENABLED=true
RISK_MAX_ORDER_QUANTITY=2000
RISK_MAX_POSITION_SIZE=3000
RISK_MAX_DAILY_LOSS=24
RISK_MAX_OPEN_TRADES=6
RISK_MAX_PRICE_DEVIATION_PERCENT=5
RISK_DUPLICATE_WINDOW_SECONDS=5

# ---------------------------------------------------------------------------
# Volatility Hedge Reversion (VHR-15) strategy
# The bot is activated on the strategy named in src/strategies/strategyManager.js
# (ACTIVE_STRATEGY = "VHR-15").
# ---------------------------------------------------------------------------
# Account equity the position sizing is based on (quote currency, e.g. USD).
STRATEGY_EQUITY=1200
# Risk per trade as a fraction of equity (0.005 = 0.5%).
STRATEGY_RISK_PERCENT=0.005
# Hard cap on risk per trade regardless of anything else (0.01 = 1%).
STRATEGY_MAX_RISK_PERCENT=0.01
# Max notional per trade as a multiple of equity. On a leveraged account this
# also acts as the exposure ceiling (20 = up to 20x total notional).
STRATEGY_MAX_NOTIONAL_EQUITY=3
# Smallest order size. On a small/leveraged account the risk-based size rounds
# to zero contracts and the bot would never trade; this floor lets it put on
# the exchange minimum (1 contract).
STRATEGY_MIN_CONTRACTS=1
# When > 0, every order is exactly this many contracts and the risk/notional
# sizing is bypassed ("always place 1 lot"). Set 0 to use risk-based sizing.
STRATEGY_FIXED_CONTRACTS=0
# How long a resting retest limit stays alive (4 x 15m candles = 60 minutes).
STRATEGY_ENTRY_VALIDITY_MINUTES=60
# How often the engine re-evaluates the strategy and manages open positions.
STRATEGY_EVALUATE_INTERVAL_MS=3000
# Closed candles requested for the 15m / 1H context. The 15m window must be
# wider than 200 + 8 so the 200 EMA and its slope are ready on the last candle.
STRATEGY_CANDLES_15M=300
STRATEGY_CANDLES_1H=100
# How many positions the strategy may hold at once (VHR-15 needs >= 4 to reach
# its 4+ orders/day target; strategies that do not use slots ignore this).
STRATEGY_MAX_CONCURRENT_POSITIONS=4

# ---------------------------------------------------------------------------
# S/R Breakout (SRB-30) strategy — the active strategy
# It is started automatically (ACTIVE_STRATEGY = "SRB-30" in
# src/strategies/strategyManager.js). It trades 30m bars aggregated from the
# 15m feed, so these settings must match the backtest or it will refuse to
# trade / trade differently:
# ---------------------------------------------------------------------------
# The 30m 200 EMA needs ~4x its period to converge (800 closed 30m bars). The
# strategy refuses to trade until then, so feed >= 2000 15m candles
# (2000 x 15m = 1000 30m bars). With 300 it never trades at all.
STRATEGY_CANDLES_15M=2000
# Retest validity is 12 x 30m bars = 360 minutes.
STRATEGY_ENTRY_VALIDITY_MINUTES=360
# The backtest runs a single position slot; a larger value changes the results.
STRATEGY_MAX_CONCURRENT_POSITIONS=1
# The 30m config never reads the 5m feed — keep this at 0 so the engine does not
# spend an extra request per cycle.
STRATEGY_CANDLES_5M=0
#
# NOTE: alternatives (both weaker than 30m). For 15m (~breakeven) set
# ACTIVE_STRATEGY = "SRB-15" and STRATEGY_CANDLES_15M=500. For 5m (loses money)
# set ACTIVE_STRATEGY = "SRB-5", STRATEGY_CANDLES_5M=2000 and
# STRATEGY_CANDLES_15M=0.

# ---------------------------------------------------------------------------
# Logging: error | warn | info | debug
# ---------------------------------------------------------------------------
LOG_LEVEL=info
